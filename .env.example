# Groq credentials, used by the "Talk to Data" page for NL->SQL and summarisation.
# Without a key the rest of the app still works; only that page fails.
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b

# SQLite database built by `python -m src.talk_to_data.query_runner --rebuild`.
# docker-compose.yml overrides this with the absolute /app/data/credit_risk.db.
DB_PATH=./data/credit_risk.db

# Cut-offs applied to the predicted default probability: Low < 0.3 <= Medium < 0.6 <= High.
RISK_THRESHOLD_LOW=0.3
RISK_THRESHOLD_HIGH=0.6
